# ConsolidaHub — variáveis de ambiente (API e worker).
# Copie para `.env` APENAS em desenvolvimento local; nunca versione o `.env`.
# Em hml/prod os valores vêm do cofre de segredos (Azure Key Vault) / configuração da plataforma.
# Nenhum valor abaixo é um segredo real.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL (o docker-compose.yml expõe o banco local somente em 127.0.0.1:5432).
# POSTGRES_PASSWORD é lida pelo docker-compose.yml; mantenha-a igual à senha das URLs abaixo.
POSTGRES_PASSWORD=troque-esta-senha-local
DATABASE_URL=postgresql://consolidahub:troque-esta-senha-local@localhost:5432/consolidahub?schema=public
# Banco "sombra" usado apenas por `npm run db:migrate:check` (detecção de drift)
SHADOW_DATABASE_URL=postgresql://consolidahub:troque-esta-senha-local@localhost:5432/consolidahub_shadow?schema=public

# Microsoft Entra ID — registro da API (veja docs/arquitetura/autenticacao.md)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Opcional: Application ID URI (padrão: api://<ENTRA_API_CLIENT_ID>)
# ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
ENTRA_REQUIRED_SCOPE=access_as_user
# Client IDs autorizados a chamar a API (o SPA). Obrigatório em produção.
ENTRA_ALLOWED_CLIENT_IDS=00000000-0000-0000-0000-000000000000
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com

# HTTP
CORS_ALLOWED_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# Limites de importação e processamento
IMPORT_MAX_FILE_BYTES=20971520
IMPORT_MAX_ROWS=200000
IMPORT_MAX_COLUMNS=500
EXECUTION_MAX_ROWS=500000
# Exportação XLSX é montada em memória: limite em células (linhas × colunas); CSV não tem limite
REPORT_XLSX_MAX_CELLS=200000
# Reuso do resultado do teste de banco do /health/ready (ms)
HEALTH_READY_CACHE_MS=2000

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_JOB_LEASE_SECONDS=300
WORKER_SHUTDOWN_GRACE_MS=30000
# WORKER_ID=worker-local
# Sinais de vida do worker (opcionais): arquivo tocado a cada progresso e/ou endpoint HTTP
# GET /health/live (usado no Azure Container Apps, que não tem probes do tipo exec).
# WORKER_HEARTBEAT_FILE=/tmp/consolidahub-worker.heartbeat
# WORKER_HEALTH_PORT=3002

# Frontend (web/) — lidos pelo docker-compose.yml no build da imagem web (valores públicos, não
# são segredos). Para `npm run dev:web` fora do Compose, use web/.env.example -> web/.env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
