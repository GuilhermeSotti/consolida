# ConsolidaHub web — configuração pública do build (NEXT_PUBLIC_* é embutido no JavaScript enviado
# ao navegador: são identificadores, não segredos; o SPA usa Authorization Code + PKCE sem segredo).
# Para `npm run dev` fora do Compose: copie para web/.env.local (ignorado pelo Git).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Client ID do registro do SPA (redirect URI do tipo "Single-page application": http://localhost:3001/)
NEXT_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Escopo delegado exposto pelo registro da API
NEXT_PUBLIC_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
