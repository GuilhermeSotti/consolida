{
  "name": "consolidahub",
  "version": "0.2.0",
  "private": true,
  "description": "ConsolidaHub — Motor de Regras e Relatório Consolidado",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0 <25"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run build:api",
    "build:api": "npm run clean && tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "start:api": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "start:web": "npm --prefix web run start",
    "dev:api": "node scripts/dev.mjs api",
    "dev:worker": "node scripts/dev.mjs worker",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,prisma}/**/*.{ts,json,md}\" \"web/{app,components,lib}/**/*.{ts,tsx,css}\"",
    "test": "jest --selectProjects unit contract e2e",
    "test:unit": "jest --selectProjects unit",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:contract": "jest --selectProjects contract",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:seed": "prisma db seed",
    "admin:grant-role": "node dist/database/grant-role.js",
    "verify": "npm run prisma:validate && npm run typecheck && npm run lint && npm test && npm run build",
    "verify:web": "npm --prefix web run typecheck && npm --prefix web run lint && npm --prefix web run build",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node dist/database/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^5.1.0",
    "@prisma/client": "5.22.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^8.57.1",
    "globals": "^13.24.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.1.0",
    "prisma": "5.22.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
